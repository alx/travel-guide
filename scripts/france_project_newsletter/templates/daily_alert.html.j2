<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alerte Grands Projets Stratégiques</title>
<style>
  body { margin: 0; padding: 0; background: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  .wrapper { max-width: 600px; margin: 24px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.1); }
  .header { background: #1a3a5c; color: #fff; padding: 24px 28px; }
  .header h1 { margin: 0 0 4px; font-size: 20px; }
  .header p { margin: 0; font-size: 13px; opacity: .75; }
  .badge-alert { display: inline-block; background: #ef4444; color: #fff; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 12px; letter-spacing: .5px; text-transform: uppercase; }
  .body { padding: 20px 28px; }
  .item { border: 1px solid #e5e7eb; border-radius: 6px; margin-bottom: 16px; overflow: hidden; }
  .item-header { padding: 10px 14px; display: flex; align-items: center; gap: 8px; }
  .cat-badge { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 10px; color: #fff; }
  .item-body { padding: 10px 14px 14px; }
  .item-body h2 { margin: 0 0 6px; font-size: 15px; line-height: 1.4; }
  .item-body h2 a { color: #1a3a5c; text-decoration: none; }
  .item-body .summary { font-size: 13px; color: #6b7280; margin: 0 0 10px; line-height: 1.5; }
  .item-body .meta { font-size: 11px; color: #9ca3af; }
  .divider { height: 1px; background: #f3f4f6; margin: 8px 0; }
  .en-label { font-size: 10px; color: #9ca3af; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 2px; }
  .footer { background: #f9fafb; padding: 16px 28px; font-size: 11px; color: #9ca3af; text-align: center; border-top: 1px solid #e5e7eb; }
  .footer a { color: #6b7280; }
  .hp-flag { font-size: 11px; color: #ef4444; font-weight: 700; margin-left: 4px; }
</style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    <span class="badge-alert">⚡ Alerte quotidienne</span>
    <h1 style="margin-top:10px;">Grands Projets Stratégiques</h1>
    <p>{{ generated }} &mdash; {{ items|length }} événement{% if items|length > 1 %}s{% endif %} prioritaire{% if items|length > 1 %}s{% endif %}</p>
  </div>

  <div class="body">
    {% if not items %}
    <p style="color:#6b7280;font-size:14px;">Aucun événement prioritaire aujourd'hui.</p>
    {% endif %}

    {% for item in items %}
    <div class="item">
      <div class="item-header" style="background:#fafafa;">
        <span class="cat-badge" style="background:{{ category_colors.get(item.category, '#64748b') }};">
          {{ category_icons.get(item.category, '🏭') }} {{ item.category }}
        </span>
        <span style="font-size:12px;color:#6b7280;">{{ item.region }}</span>
        {% if item.high_priority %}<span class="hp-flag">▲ Prioritaire</span>{% endif %}
      </div>
      <div class="item-body">
        <h2><a href="{{ item.url }}">{{ item.title_fr }}</a></h2>
        {% if item.summary_fr %}
        <p class="summary">{{ item.summary_fr[:300] }}{% if item.summary_fr|length > 300 %}…{% endif %}</p>
        {% endif %}
        {% if item.title_en and item.title_en != item.title_fr %}
        <div class="divider"></div>
        <div class="en-label">EN</div>
        <p class="summary" style="margin:0 0 8px;">{{ item.title_en }}</p>
        {% if item.summary_en and item.summary_en != item.summary_fr %}
        <p class="summary" style="margin:0 0 8px;">{{ item.summary_en[:300] }}{% if item.summary_en|length > 300 %}…{% endif %}</p>
        {% endif %}
        {% endif %}
        <p class="meta">{{ item.company }} &bull; {{ item.date[:10] }} &bull; {{ item.source }}</p>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="footer">
    <p>
      <a href="{{ map_url }}">Voir la carte interactive</a> &bull;
      <a href="*|UNSUB|*">Se désabonner / Unsubscribe</a>
    </p>
    <p>Grands Projets Stratégiques &mdash; France 2030</p>
  </div>
</div>
</body>
</html>
