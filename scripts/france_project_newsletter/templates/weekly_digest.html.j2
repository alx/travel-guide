<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grands Projets Stratégiques — Digest hebdomadaire</title>
<style>
  body { margin: 0; padding: 0; background: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  .wrapper { max-width: 640px; margin: 24px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.1); }
  .header { background: #1a3a5c; color: #fff; padding: 28px 32px; }
  .header h1 { margin: 0 0 6px; font-size: 22px; }
  .header .subtitle { margin: 0; font-size: 13px; opacity: .75; }
  .stats { display: flex; gap: 24px; margin-top: 16px; }
  .stat { text-align: center; }
  .stat .n { font-size: 24px; font-weight: 700; }
  .stat .l { font-size: 11px; opacity: .65; text-transform: uppercase; letter-spacing: .5px; }
  .body { padding: 24px 32px; }
  .section-title { display: flex; align-items: center; gap: 8px; margin: 24px 0 12px; padding-bottom: 8px; border-bottom: 2px solid; font-size: 15px; font-weight: 700; }
  .item { padding: 12px 0; border-bottom: 1px solid #f3f4f6; }
  .item:last-child { border-bottom: none; }
  .item-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
  .item h3 { margin: 0 0 4px; font-size: 14px; line-height: 1.4; }
  .item h3 a { color: #1a3a5c; text-decoration: none; }
  .item .summary-fr { font-size: 12px; color: #374151; margin: 0 0 4px; line-height: 1.5; }
  .item .summary-en { font-size: 11px; color: #9ca3af; margin: 0 0 4px; line-height: 1.5; font-style: italic; }
  .item .meta { font-size: 10px; color: #d1d5db; }
  .hp { color: #ef4444; font-size: 10px; font-weight: 700; white-space: nowrap; }
  .region-tag { font-size: 10px; background: #f3f4f6; color: #6b7280; padding: 1px 6px; border-radius: 8px; white-space: nowrap; }
  .footer { background: #f9fafb; padding: 20px 32px; font-size: 11px; color: #9ca3af; text-align: center; border-top: 1px solid #e5e7eb; }
  .footer a { color: #6b7280; }
  .map-cta { display: block; margin: 0 32px 24px; padding: 12px; background: #f0f4ff; border: 1px solid #c7d2fe; border-radius: 6px; text-align: center; font-size: 13px; font-weight: 600; color: #1a3a5c; text-decoration: none; }
</style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    <h1>🏭 Grands Projets Stratégiques</h1>
    <p class="subtitle">Digest hebdomadaire &mdash; Semaine du {{ generated }} / Weekly digest &mdash; Week of {{ generated }}</p>
    <div class="stats">
      <div class="stat"><div class="n">{{ digest.total_items }}</div><div class="l">Articles</div></div>
      <div class="stat"><div class="n">{{ digest.high_priority_count }}</div><div class="l">Prioritaires</div></div>
      <div class="stat"><div class="n">{{ groups|length }}</div><div class="l">Secteurs</div></div>
    </div>
  </div>

  <a class="map-cta" href="{{ map_url }}">🗺️ Voir la carte interactive des 69 projets / View the interactive map</a>

  <div class="body">
    {% for category, cat_items in groups.items() %}
    <div class="section-title" style="border-color:{{ category_colors.get(category, '#64748b') }};color:{{ category_colors.get(category, '#64748b') }};">
      {{ category_icons.get(category, '🏭') }} {{ category }}
      <span style="font-size:12px;font-weight:400;color:#9ca3af;">({{ cat_items|length }})</span>
    </div>

    {% for item in cat_items %}
    <div class="item">
      <div class="item-top">
        <div>
          <h3><a href="{{ item.url }}">{{ item.title_fr }}</a></h3>
          {% if item.title_en and item.title_en != item.title_fr %}
          <div class="summary-en">{{ item.title_en }}</div>
          {% endif %}
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">
          {% if item.high_priority %}<span class="hp">▲ Prioritaire</span>{% endif %}
          <span class="region-tag">{{ item.region }}</span>
        </div>
      </div>
      {% if item.summary_fr %}
      <p class="summary-fr">{{ item.summary_fr[:250] }}{% if item.summary_fr|length > 250 %}…{% endif %}</p>
      {% endif %}
      {% if item.summary_en and item.summary_en != item.summary_fr %}
      <p class="summary-en">{{ item.summary_en[:200] }}{% if item.summary_en|length > 200 %}…{% endif %}</p>
      {% endif %}
      <p class="meta">{{ item.company }} &bull; {{ item.date[:10] }} &bull; {{ item.source }}</p>
    </div>
    {% endfor %}
    {% endfor %}

    {% if not groups %}
    <p style="color:#6b7280;font-size:14px;">Aucun article collecté cette semaine.</p>
    {% endif %}
  </div>

  <div class="footer">
    <p>
      <a href="{{ map_url }}">Carte interactive</a> &bull;
      <a href="*|UNSUB|*">Se désabonner / Unsubscribe</a>
    </p>
    <p>Grands Projets Stratégiques &mdash; France 2030</p>
  </div>
</div>
</body>
</html>
