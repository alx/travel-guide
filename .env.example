# Reddit API credentials (https://www.reddit.com/prefs/apps — create a "script" app)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=reddit-to-map/1.0 by u/your_username

# Required for --reply (posting comments back to Reddit)
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Optional: LocationIQ geocoding fallback (https://locationiq.com — free tier)
LOCATIONIQ_API_KEY=pk.your_key_here

# France Grands Projets Newsletter
CHANGEDETECTION_API_KEY=your_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here
CHANGEDETECTION_BASE_URL=http://lamai270:5008
MAILCHIMP_API_KEY=your_api_key-us1
MAILCHIMP_LIST_ID=your_audience_id
MAILCHIMP_SERVER_PREFIX=us1
