        },
        {
          "type": "Point",
          "coordinates": [
            99.854,
            9.642
          ],
          "properties": {
            "name": "Fishing Ground Alpha \u2014 Red Snapper Shelf",
            "category": "Fishing",
            "notes": "Rocky shelf at 18\u201322 m. Best on incoming tide for red snapper and grouper. Drop anchor; no trolling.",
            "icon": "\ud83c\udfa3",
            "hours": "Best: 06:30\u201311:00"
          }
        },
        {
          "type": "Point",
          "coordinates": [
            99.948,
            9.728
          ],
          "properties": {
            "name": "Koh Pha Nok anchorage",
            "category": "Anchorage",
            "notes": "Small uninhabited island. Protected bay on E side, 3\u20134 m sandy bottom. Fresh water stream (seasonal). Overnight only \u2014 no facilities.",
            "icon": "\ud83c\udf19",
            "hours": "Anchor ~17:30, depart 05:00"
          }
        },
        {
          "type": "Point",
          "coordinates": [
            99.996,
            9.665
          ],
          "properties": {
            "name": "Float Net Zone",
            "category": "Hazard",
            "notes": "Local commercial nets mark this area. Navigate at slow speed, watch for rope ends. Respect the buoys.",
            "icon": "\u26a0\ufe0f"
          }
        },
        {
          "type": "Point",
          "coordinates": [
            100.152,
            9.508
          ],
          "properties": {
            "name": "Fishing Ground Beta \u2014 Tuna Alley",
            "category": "Fishing",
            "notes": "Deep channel, 45\u201360 m. Trolling for yellowfin tuna. Use lures at 6\u20138 knots. Prime spot on afternoon outgoing tide.",
            "icon": "\ud83c\udfa3",
            "hours": "Best: 10:00\u201314:30"
          }
        },
        {
