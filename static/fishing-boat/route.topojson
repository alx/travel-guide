          "properties": {
            "name": "Nathon Pier",
            "category": "Port",
            "notes": "Main departure / arrival. Depart 04:30 \u2014 buy ice blocks at the pier head.",
            "icon": "\u2693",
            "hours": "Depart 04:30 \u00b7 Return Day 2 ~16:00"
